# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://filehost:filehost123@localhost:5432/filehost

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRES_IN=7d

# AWS S3 / MinIO
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=filehost
AWS_S3_ENDPOINT=http://minio:9000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Turnstile CAPTCHA
TURNSTILE_SECRET_KEY=your_turnstile_secret

# Email
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=noreply@filehost.local

# Admin
ADMIN_EMAIL=admin@filehost.local
ADMIN_PASSWORD=Admin123!@#

# File Expiration Retention (days)
FILE_RETENTION_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_RATE_LIMIT_MAX=50

# File Upload
MAX_FILE_SIZE=5368709120
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,video/mp4,video/webm,audio/mpeg,audio/wav,text/plain,text/csv,application/json,application/zip,application/x-rar-compressed,application/x-7z-compressed
